# Provider credentials — referenced via env only, never stored in DB (ARCHITECTURE §4.2).
# Add a new provider => add its key here AND restart the gateway.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional: point the `openai/` prefix at a custom OpenAI-compatible endpoint
# (e.g. Alibaba DashScope compatible-mode, or any aggregator). LiteLLM reads this
# OS env var directly to route `openai/<model>` calls — config.py does not need it,
# but it MUST be set here (and `docker compose up -d` to reload) for third-party
# endpoints. Example: https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_BASE=

# Optional informational default model. M0 still REQUIRES `model` in each request.
DEFAULT_MODEL=gpt-4o-mini

# --- M1 configuration ---
# SQLite DB location (default ./data/gateway.db). Override for Postgres later.
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db

# Required at FIRST boot to create the initial admin. If unset while the
# accounts table is empty, the gateway REFUSES TO START (fail-loud, R5).
BOOTSTRAP_ADMIN_PASSWORD=
# Optional admin username (default: admin).
BOOTSTRAP_ADMIN_USERNAME=admin

# JWT signing secret for DB-backed sessions. CHANGE THIS in any real deployment.
JWT_SECRET=change-me-in-production

# Redis — REQUIRED from M2 (daily-token quota counter + usage accounting).
# Set REDIS_URL in production (e.g. redis://redis:6379) OR leave empty and set
# REDIS_FAKE=1 for local tests (in-process fakeredis, no redis-server needed).
# The gateway fails to start if neither is set (M2_DEV_PLAN R4: PING fail-loud).
REDIS_URL=
REDIS_FAKE=0

# Session lifetime in minutes (affects sessions.expires_at, R1). Default 60.
SESSION_EXPIRE_MIN=60

# Test-only: set to 1 to enable the mock/echo adapter (no real provider key
# needed for end-to-end routing tests, R4). Leave 0 in production.
MOCK_PROVIDER=0

# --- Semantic-cache embedding backend (M4) ---
# Point SEMANTIC_EMBEDDING_API_BASE at a real OpenAI-compatible /v1/embeddings
# server. The bundled docker-compose starts one (quentinz/bge-small-zh-v1.5):
#   - docker-internal (gateway runs in compose): http://embedding:11434/v1
#   - host-run gateway (redis+embedding only in compose): http://localhost:8001/v1
# Leave empty => semantic layer degrades gracefully (no semantic hits, no errors).
# When a real server is configured, MOCK_PROVIDER MUST be 0 (else fake embedding).
SEMANTIC_CACHE_ENABLE=1
SEMANTIC_EMBEDDING_MODEL=quentinz/bge-small-zh-v1.5
SEMANTIC_EMBEDDING_API_BASE=
SEMANTIC_EMBEDDING_API_KEY=
